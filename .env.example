# Copy this file to .env.local for development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit the real .env.local file to GitHub.

# --- Supabase (database, auth, storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never exposed to the browser

# --- Site ---
PUBLIC_SITE_URL=https://alora-lac-zeta.vercel.app

# --- Paymob (cards + wallets + Fawry) — fill in once merchant approval arrives ---
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=           # comma-separated, one per payment method enabled

# --- Pi Network (secondary/optional payment method) ---
PI_API_BASE=https://api.minepi.com
PI_API_KEY=

# --- AI Style Assistant (Section 5.4 of SPEC.md) ---
# Use whichever LLM provider the team picks; OpenAI shown as an example.
OPENAI_API_KEY=
